# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_NAME=ProTrade

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=protrade
DB_USER=root
DB_PASS=

# Security
ENCRYPTION_KEY=your-secret-key-32-chars-minimum
JWT_SECRET=your-jwt-secret-key-minimum-32-chars

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@protrade.com
MAIL_FROM_NAME=ProTrade

# Trading Configuration
MIN_ORDER_VALUE=1
MAX_ORDER_VALUE=10000000
TRADING_COMMISSION=0.05
MARKET_OPEN_HOUR=9
MARKET_CLOSE_HOUR=15

# Wallet Configuration
MIN_DEPOSIT=1000
MAX_DEPOSIT=10000000
MIN_WITHDRAWAL=100

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY=300
